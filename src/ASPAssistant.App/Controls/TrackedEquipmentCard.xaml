<UserControl x:Class="ASPAssistant.App.Controls.TrackedEquipmentCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ASPAssistant.App.Controls"
             PreviewMouseWheel="OnPreviewMouseWheel">
    <Border x:Name="CardBorder" Style="{StaticResource ItemCardBorder}" Padding="8,6"
            ToolTipService.InitialShowDelay="0" ToolTipService.BetweenShowDelay="0"
            ToolTipService.ShowDuration="60000">
        <Border.ToolTip>
            <ToolTip x:Name="DetailsToolTip" Placement="Left" HorizontalOffset="-8"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                     Background="Transparent" BorderThickness="0" Padding="0" HasDropShadow="False"
                     MaxHeight="700">
                <Border Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="10" Padding="6"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Width="320">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <controls:EquipmentCard x:Name="DetailsCard" ShowTrackingButton="False" />
                    </ScrollViewer>
                </Border>
            </ToolTip>
        </Border.ToolTip>
        <Grid MinHeight="26">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" MaxWidth="160" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="NameText" Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"
                       VerticalAlignment="Center" Margin="0,0,6,0" />
            <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                       VerticalAlignment="Center" Margin="0,0,7,0">
                <ItemsControl x:Name="CategoryChips" ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Right" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource NeutralTintBrush}" CornerRadius="3"
                                    Padding="4,1" Margin="3,0,0,2">
                                <TextBlock Text="{Binding}" FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="TypeText" VerticalAlignment="Center" Margin="5,0,0,2" FontSize="10" TextWrapping="Wrap"
                           TextAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" />
            </WrapPanel>
            <Button x:Name="TrackButton" Grid.Column="2" Content="✕" Width="25" Height="25" Padding="0" FontSize="14"
                    VerticalAlignment="Center" ToolTip="取消追踪装备"
                    Style="{StaticResource TrackingButton}" Click="OnRemoveClick" />
        </Grid>
    </Border>
</UserControl>
