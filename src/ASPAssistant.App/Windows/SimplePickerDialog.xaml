<Window x:Class="ASPAssistant.App.Windows.SimplePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:ASPAssistant.App.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="选择"
        Width="420" Height="540"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource PanelBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Icon="{StaticResource AspaLogo}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <converters:LocalPathToImageConverter x:Key="PathToImage" />
    </Window.Resources>
    <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource TitleBackgroundBrush}" MouseLeftButtonDown="OnTitleBarDrag">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Click="OnCancelClick"
                            Style="{StaticResource CloseButton}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TitleText" Text="选择"
                                   Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"
                                   FontWeight="SemiBold" Padding="12,8" VerticalAlignment="Center" />
                        <CheckBox x:Name="CoreEquipmentToggle" Content="设为核心" Visibility="Collapsed"
                                  FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0"
                                  Foreground="{DynamicResource AccentBrush}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Top" Padding="10,8,10,4">
                <TextBox x:Name="SearchBox"
                         Background="{DynamicResource InputOverlayBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                         CaretBrush="{DynamicResource AccentBrush}"
                         Padding="4,4" FontSize="12"
                         TextChanged="OnSearchTextChanged" />
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{DynamicResource TitleBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                    Padding="10,6">
                <DockPanel>
                    <Button x:Name="ConfirmButton" DockPanel.Dock="Right" Content="确定" Click="OnConfirmClick"
                            Visibility="Collapsed" Style="{StaticResource TrackingButton}" Padding="12,4" Margin="8,0,0,0" />
                    <Button DockPanel.Dock="Right" Content="清除选择" Click="OnClearClick"
                            Padding="10,4" FontSize="12" Cursor="Hand"
                            Background="{DynamicResource NeutralHoverBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock x:Name="HintText" Text=""
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <ListBox x:Name="ItemsList" Background="Transparent" BorderThickness="0"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionMode="Single"
                     SelectionChanged="OnItemSelected" MouseDoubleClick="OnItemDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Padding" Value="4" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="ToolTipService.InitialShowDelay" Value="200" />
                        <Setter Property="ToolTip">
                            <Setter.Value>
                                <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                         Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" Padding="8">
                                    <TextBlock Text="{Binding Summary}" Width="300" MaxHeight="240" TextWrapping="Wrap"
                                               FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </ToolTip>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="bg" Background="{TemplateBinding Background}"
                                            CornerRadius="3" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource NeutralHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Summary}" Value="{x:Null}">
                                <Setter Property="ToolTip" Value="{x:Null}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="32" Height="32" Margin="0,0,8,0"
                                    Background="{DynamicResource NeutralHoverBrush}" CornerRadius="3" ClipToBounds="True">
                                <Image Source="{Binding IconPath, Converter={StaticResource PathToImage}}"
                                       Stretch="UniformToFill" />
                            </Border>
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding RightLabel}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="8,0,2,0"
                                       TextAlignment="Right" />
                            <TextBlock Text="{Binding Display}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="12" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</Window>
