<!-- Modified for ASP Assistant Arknights on 2026-11-12; see NOTICE. -->
<Window x:Class="ASPAssistant.App.Windows.LineupEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:ASPAssistant.App.Converters"
        xmlns:models="clr-namespace:ASPAssistant.Core.Models;assembly=ASPAssistant.Core"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="阵容编辑"
        Width="980" Height="660" MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource PanelBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Icon="{StaticResource AspaLogo}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <converters:LocalPathToImageConverter x:Key="PathToImage" />

        <Style x:Key="EditorPrimaryButton" TargetType="Button" BasedOn="{StaticResource DialogPrimaryButton}" />
        <Style x:Key="EditorSecondaryButton" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButton}">
            <Setter Property="Height" Value="Auto" />
            <Setter Property="MinHeight" Value="30" />
        </Style>
        <!-- A small pill-shaped chip used for tags / equipment slots inside slot card -->
        <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource ClickableButtonBase}">
            <Setter Property="Background" Value="{DynamicResource SectionBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource RowCornerRadius}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="active">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource AccentSolidBrush}" />
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource AccentSolidBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="Tag" Value="core">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <DockPanel>
            <!-- Title bar -->
            <Border DockPanel.Dock="Top" Style="{StaticResource DialogTitleBar}" MouseLeftButtonDown="OnTitleBarDrag">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Tag="{StaticResource IconClose}" ToolTip="关闭" Click="OnCancelClick"
                            Style="{StaticResource CloseButton}" />
                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                        <TextBlock Text="阵容编辑器" Style="{StaticResource DialogTitleText}" Padding="2,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Bottom action bar -->
            <Border Style="{StaticResource DialogFooter}" DockPanel.Dock="Bottom">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button x:Name="ResetButton" Content="重置" Style="{StaticResource EditorSecondaryButton}"
                                Click="OnResetClick" Margin="0,0,8,0" />
                        <Button x:Name="ClearButton" Content="清空" Style="{StaticResource EditorSecondaryButton}"
                                Click="OnClearClick" Margin="0,0,8,0" />
                        <Button Content="取消" Style="{StaticResource EditorSecondaryButton}"
                                Click="OnCancelClick" Margin="0,0,8,0" />
                        <Button Content="保存" Style="{StaticResource EditorPrimaryButton}"
                                Click="OnSaveClick" />
                    </StackPanel>
                    <TextBlock x:Name="EditorHint"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                </DockPanel>
            </Border>

            <!-- Body: slots grid + covenant panel -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="240" />
                </Grid.ColumnDefinitions>

                <!-- Slots grid -->
                <DockPanel x:Name="SlotsPanel" Grid.Column="0" Margin="12">
                    <!-- Top: name + summary -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource CardCornerRadius}" Padding="10" Margin="4,0,4,10">
                        <DockPanel>
                            <Border DockPanel.Dock="Right"
                                    Background="{DynamicResource AccentSoftBrush}" CornerRadius="{DynamicResource PillCornerRadius}"
                                    Padding="8,4" VerticalAlignment="Center">
                                <TextBlock x:Name="ActivatedSummaryText"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Text="激活 0 个盟约" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="阵容名" Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="10" />
                                <TextBox Style="{StaticResource DialogTextBox}" x:Name="LineupNameBox" FontSize="14"
                                         TextChanged="OnLineupNameChanged" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <WrapPanel x:Name="PhaseTabs" DockPanel.Dock="Top" Margin="4,0,0,6" />

                    <!-- 9 slot cards in 3x3 grid -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="SlotsHost">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="3" Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!-- Right: covenant breakdown -->
                <Border x:Name="CovenantPanel" Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="盟约人数" Style="{StaticResource FilterSectionTitle}" Margin="12,12,12,6" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="CovenantStatsList" Padding="10,4,10,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="{DynamicResource RowCornerRadius}" Padding="9,6" Margin="0,0,0,4"
                                                Tag="{Binding Activated}"
                                                Loaded="OnCovenantRowLoaded">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right"
                                                           FontSize="13" FontWeight="Bold" FontFamily="{DynamicResource NumberFontFamily}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center">
                                                    <Run Text="{Binding Count, Mode=OneWay}" />
                                                    <Run Text="/" />
                                                    <Run Text="{Binding ActivateCount, Mode=OneWay, TargetNullValue='?'}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           FontSize="12" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</Window>
