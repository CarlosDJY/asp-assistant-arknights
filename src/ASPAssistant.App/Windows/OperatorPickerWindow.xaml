<Window x:Class="ASPAssistant.App.Windows.OperatorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:ASPAssistant.App.Converters"
        Title="选择干员" Width="780" Height="700" MinWidth="600" MinHeight="520"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource PanelBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        Icon="{StaticResource AspaLogo}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <converters:LocalPathToImageConverter x:Key="PathToImage" />
        <converters:TierToRomanConverter x:Key="TierToRoman" />
        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <DataTemplate x:Key="CovenantLabel">
            <TextBlock Text="{Binding}" Margin="0,0,8,0" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
        </DataTemplate>
    </Window.Resources>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource TitleBackgroundBrush}" MouseLeftButtonDown="OnTitleBarDrag">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Click="OnCancelClick" Style="{StaticResource CloseButton}" />
                    <TextBlock Text="选择干员" FontSize="13" FontWeight="SemiBold" Padding="12,8" />
                </DockPanel>
            </Border>
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource TitleBackgroundBrush}" Padding="12,8"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="清除选择" Click="OnClearClick" Style="{StaticResource TrackingButton}" Padding="10,4" />
                    <TextBlock FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}">
                        <Run Text="{Binding FilteredOperators.Count, Mode=OneWay}" /><Run Text=" 位干员 · 单击或按 Enter 选择 · 可拖动窗口边缘放大" />
                    </TextBlock>
                </DockPanel>
            </Border>
            <Grid Margin="12,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="1.2*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8">
                    <Button x:Name="ResetFiltersButton" DockPanel.Dock="Right" Content="重置筛选" Click="OnResetFiltersClick"
                            Style="{StaticResource TrackingButton}" Padding="10,4" Margin="8,0,0,0" />
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="搜索干员名称" Padding="8,5" Background="{DynamicResource InputBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}"
                             CaretBrush="{DynamicResource AccentBrush}" />
                </DockPanel>
                <ScrollViewer x:Name="FilterScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,6,0">
                        <TextBlock Text="等阶（多选，不选为全部）" Style="{StaticResource FilterLabel}" />
                        <ListBox x:Name="TierFilters" Style="{StaticResource FilterChipListBox}" SelectionMode="Multiple" SelectionChanged="OnFiltersChanged">
                            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource TierToRoman}}" /></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Content="同时满足" IsChecked="{Binding CoreCovenantMatchAll}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="核心盟约（多选）" Style="{StaticResource FilterLabel}" />
                        </DockPanel>
                        <ListBox x:Name="CoreFilters" Style="{StaticResource FilterChipListBox}" SelectionMode="Multiple" SelectionChanged="OnFiltersChanged" />
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Content="同时满足" IsChecked="{Binding OtherCovenantMatchAll}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="其他盟约（多选）" Style="{StaticResource FilterLabel}" />
                        </DockPanel>
                        <ListBox x:Name="OtherFilters" Style="{StaticResource FilterChipListBox}" SelectionMode="Multiple" SelectionChanged="OnFiltersChanged" />
                        <Grid Margin="0,4,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="词条" Style="{StaticResource FilterLabel}" />
                                <ComboBox x:Name="TraitFilter" SelectionChanged="OnSingleFilterChanged" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="触发时机" Style="{StaticResource FilterLabel}" />
                                <ComboBox x:Name="TimingFilter" SelectionChanged="OnSingleFilterChanged" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
                <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              Background="{DynamicResource BorderBrush}" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />
                <Grid Grid.Row="3">
                    <ListBox x:Name="OperatorsList" ItemsSource="{Binding FilteredOperators}" Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource TextPrimaryBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseLeftButtonUp="OnOperatorClick" PreviewKeyDown="OnOperatorKeyDown">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource ClickableListBoxItemBase}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="8,5" />
                                <Setter Property="Margin" Value="0,0,0,3" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Image DockPanel.Dock="Left" Source="{Binding IconPath, Converter={StaticResource PathToImage}}" Width="40" Height="40" Margin="0,0,10,0" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Tier, StringFormat=T{0}}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,0,0,0" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                                        <ItemsControl ItemsSource="{Binding CoreCovenants}" ItemTemplate="{StaticResource CovenantLabel}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding AdditionalCovenants}" ItemTemplate="{StaticResource CovenantLabel}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding EmptyListMessage}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding FilteredOperators.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </DockPanel>
    </Border>
</Window>
