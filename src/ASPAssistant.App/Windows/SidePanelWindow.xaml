<!-- Modified for ASP Assistant Arknights on 2026-11-13; see NOTICE. -->
<Window x:Class="ASPAssistant.App.Windows.SidePanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ASPAssistant.App.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="鸿雪·卫戍助手"
        Width="310" MinWidth="280" MaxWidth="400"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True"
        Topmost="True"
        Cursor="Arrow"
        Icon="{StaticResource AspaLogo}"
        Background="{DynamicResource PanelBackgroundBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>
    <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <DockPanel>
            <!-- Custom title bar: logo, terminal level / round status, settings · minimize · close -->
            <Border DockPanel.Dock="Top" Height="36" Background="{DynamicResource TitleBackgroundBrush}"
                    BorderBrush="{DynamicResource TitleDecorBrush}" BorderThickness="{DynamicResource TitleDecorThickness}"
                    MouseLeftButtonDown="OnTitleBarDrag">
                <DockPanel x:Name="TitleBarDock" SizeChanged="OnTitleBarSizeChanged">
                    <StackPanel x:Name="TitleBarActions" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,2,0"
                                SizeChanged="OnTitleBarSizeChanged">
                        <!-- 全屏运行提示：琥珀色图标，点开看说明 -->
                        <Button x:Name="FullscreenHintButton" Visibility="Collapsed" Click="OnFullscreenHintClick" Tag="{StaticResource IconEnemy}"
                                Margin="0,0,4,0" AutomationProperties.Name="窗口模式提示" ToolTip="推荐在窗口模式下运行">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                    <Setter Property="Background" Value="{DynamicResource WarningTintBrush}" />
                                </Style>
                            </Button.Style>
                        </Button>
                        <!-- 更新：下载中是进度环 + 百分比，下载完成变成实心「重启更新」 -->
                        <Button x:Name="UpdateChip" Visibility="Collapsed" Click="OnUpdateChipClick" Margin="0,0,4,0" Cursor="Hand"
                                VerticalAlignment="Center" AutomationProperties.Name="更新">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Height="24" CornerRadius="12" Padding="8,0" BorderThickness="1"
                                            Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Opacity" Value="0.88" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <Grid x:Name="UpdateRing" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center">
                                    <Ellipse Stroke="{DynamicResource AccentBorderBrush}" StrokeThickness="2" />
                                    <Ellipse x:Name="UpdateRingArc" Stroke="{DynamicResource AccentSolidBrush}" StrokeThickness="2"
                                             StrokeDashArray="0 100" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform><RotateTransform Angle="-90" /></Ellipse.RenderTransform>
                                    </Ellipse>
                                </Grid>
                                <Path x:Name="UpdateArrow" Data="M 6 11 L 6 1 M 1.5 5.5 L 6 1 L 10.5 5.5" Width="12" Height="12" Margin="0,0,4,0"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" Visibility="Collapsed" />
                                <TextBlock x:Name="UpdateChipText" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SettingsButton" Click="OnToggleSettings" Tag="{StaticResource IconSettings}"
                                AutomationProperties.Name="设置" ToolTip="设置">
                            <Button.Style>
                                <!-- Highlighted while the settings panel is open -->
                                <Style TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Visibility, ElementName=SettingsPanel}" Value="Visible">
                                            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Click="OnMinimize" Tag="{StaticResource IconMinimize}" AutomationProperties.Name="最小化" ToolTip="最小化"
                                Style="{StaticResource TitleBarButton}" />
                        <Button Click="OnClose" Tag="{StaticResource IconClose}" AutomationProperties.Name="关闭" ToolTip="关闭"
                                Style="{StaticResource CloseButton}" />
                    </StackPanel>
                    <!-- The name gives way first when the update chip or a narrow panel leaves no room (see FitBrandTitle). -->
                    <StackPanel x:Name="TitleBarBrand" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource IconLogo}" Stroke="{DynamicResource TitleDecorBrush}" StrokeThickness="2"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Name="BrandTitleText" Text="鸿雪·卫戍助手" Foreground="{DynamicResource TitleTextBrush}"
                                   FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="7,0,6,0"
                                   ToolTip="鸿雪·卫戍助手" />
                        <Border x:Name="StatusChip" Height="22" CornerRadius="11" Padding="6,0" VerticalAlignment="Center"
                                Background="{DynamicResource TitleChipBrush}" BorderBrush="{DynamicResource TitleChipBorderBrush}"
                                BorderThickness="1" ToolTip="终端等级：从商店左侧的升级卡自动识别，可在追踪页手动指定">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="终端" FontSize="11" Foreground="{DynamicResource TitleMutedBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="StatusTerminalText" Text="–" Margin="5,0,0,0" FontSize="14" FontWeight="Bold"
                                           FontFamily="{DynamicResource NumberFontFamily}" Foreground="{DynamicResource TitleTextBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <DockPanel x:Name="PanelContent">
            <!-- Tab content + visible resize grip overlay -->
            <Grid x:Name="ContentRoot">
                <!-- 更新气泡：贴窗口右侧，小箭头对准标题栏里的更新胶囊 -->
                <Grid x:Name="UpdatePopover" Panel.ZIndex="50" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,8,0"
                      MaxWidth="236" Visibility="Collapsed">
                    <Border Padding="12,10" BorderThickness="1" CornerRadius="{DynamicResource CardCornerRadius}"
                            Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}">
                        <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.18" /></Border.Effect>
                        <StackPanel>
                            <TextBlock x:Name="UpdatePopTitle" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock x:Name="UpdatePopMeta" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <UniformGrid Columns="2" Margin="0,10,0,0">
                                <Button x:Name="UpdatePopPrimary" Margin="0,0,3,0" Tag="accent" Style="{StaticResource SmallActionButton}" Click="OnBannerAction" />
                                <Button Content="跳过该版本" Margin="3,0,0,0" Style="{StaticResource SmallActionButton}" Click="OnSkipVersion" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                    <Border x:Name="UpdatePopArrow" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,40,0"
                            BorderThickness="1,1,0,0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><RotateTransform Angle="45" /></Border.RenderTransform>
                    </Border>
                </Grid>
                <!-- 全屏提示气泡 -->
                <Grid x:Name="FullscreenPopover" Panel.ZIndex="50" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,8,0"
                      MaxWidth="220" Visibility="Collapsed">
                    <Border Padding="12,10" BorderThickness="1" CornerRadius="{DynamicResource CardCornerRadius}"
                            Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}">
                        <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.18" /></Border.Effect>
                        <StackPanel>
                            <TextBlock Text="推荐在窗口模式下运行" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource WarningTextBrush}" />
                            <TextBlock Text="全屏下有遮挡时，拖动侧栏右下角调整大小" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <UniformGrid Columns="2" Margin="0,10,0,0">
                                <Button Content="知道了" Margin="0,0,3,0" Style="{StaticResource SmallActionButton}" Click="OnFullscreenHintOk" />
                                <Button Content="不再提示" Margin="3,0,0,0" Style="{StaticResource SmallActionButton}" Click="OnFullscreenHintOff" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                    <Border x:Name="FullscreenPopArrow" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,40,0"
                            BorderThickness="1,1,0,0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><RotateTransform Angle="45" /></Border.RenderTransform>
                    </Border>
                </Grid>
                <TabControl x:Name="MainTabs" Style="{StaticResource DarkTabControl}" SelectionChanged="OnMainTabChanged">
                    <!-- 图鉴: operators and equipment behind one segment -->
                    <TabItem x:Name="CodexTab" Header="图鉴" Tag="{StaticResource IconCodex}" HorizontalContentAlignment="Stretch">
                        <DockPanel Background="{DynamicResource PanelBackgroundBrush}">
                            <Border DockPanel.Dock="Top" Padding="10,10,10,0">
                                <ListBox x:Name="CodexSegment" Style="{StaticResource SegmentedListBox}" HorizontalAlignment="Stretch"
                                         SelectedIndex="0" SelectionChanged="OnCodexSegmentChanged">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource SegmentedItem}">
                                            <Setter Property="MinHeight" Value="26" />
                                            <Setter Property="FontSize" Value="12" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBoxItem Content="干员" />
                                    <ListBoxItem Content="装备" />
                                </ListBox>
                            </Border>
                            <Grid>
                                <views:OperatorBrowseView x:Name="OperatorView" />
                                <views:EquipmentBrowseView x:Name="EquipmentView" Visibility="Collapsed" />
                            </Grid>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="追踪" Tag="{StaticResource IconTracking}">
                        <views:TrackingView x:Name="TrackingView" />
                    </TabItem>
                    <!-- 阵容: saved lineups (search / 筛选 / 本局推荐) and the planner behind one segment -->
                    <TabItem x:Name="LineupsTab" Header="阵容" Tag="{StaticResource IconLineups}">
                        <DockPanel Background="{DynamicResource PanelBackgroundBrush}">
                            <Border DockPanel.Dock="Top" Padding="10,10,10,0">
                                <ListBox x:Name="LineupsSegment" Style="{StaticResource SegmentedListBox}" HorizontalAlignment="Stretch"
                                         SelectedIndex="0" SelectionChanged="OnLineupsSegmentChanged">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <!-- same size as 追踪's 购买清单 / 站位 -->
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource SegmentedItem}">
                                            <Setter Property="MinHeight" Value="26" />
                                            <Setter Property="FontSize" Value="12" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBoxItem Content="我的阵容" />
                                    <ListBoxItem Content="规划" />
                                </ListBox>
                            </Border>
                            <Grid>
                                <views:LineupListView x:Name="LineupView" />
                                <views:LineupPlannerView x:Name="PlannerView" Visibility="Collapsed" />
                            </Grid>
                        </DockPanel>
                    </TabItem>
                    <TabItem x:Name="RunInfoTab" Header="对局信息" Tag="{StaticResource IconEnemy}">
                        <DockPanel>
                            <views:RunBanView x:Name="RunBanView" DockPanel.Dock="Top" Margin="10,10,10,0" />
                            <views:EnemyView x:Name="EnemyView" />
                        </DockPanel>
                    </TabItem>
                </TabControl>

                <!-- Settings page: covers the tabs; the gear (or 返回) closes it -->
                <Border x:Name="SettingsPanel" Visibility="Collapsed" Background="{DynamicResource PanelBackgroundBrush}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Height="46" Background="{DynamicResource TabBarBackgroundBrush}"
                                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Click="OnToggleSettings" Tag="{StaticResource IconBack}" ToolTip="返回" AutomationProperties.Name="返回"
                                        Style="{StaticResource TitleBarButton}" Foreground="{DynamicResource TabTextBrush}" />
                                <TextBlock Text="设置" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0"
                                           Foreground="{DynamicResource TabActiveBrush}" />
                            </StackPanel>
                        </Border>
                        <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="10,0,10,14">
                                <StackPanel x:Name="GameThemePanel">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="手动" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChecked, ElementName=AutomaticThemeToggle}" Value="True">
                                                            <Setter Property="Text" Value="自动" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <CheckBox x:Name="AutomaticThemeToggle" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"
                                                  AutomationProperties.Name="模式主题自动识别" />
                                    </StackPanel>
                                    <TextBlock Text="模式主题" Style="{StaticResource SettingsCaption}" />
                                </DockPanel>
                                <ListBox x:Name="GameThemeSelector" IsEnabled="{Binding IsChecked, ElementName=AutomaticThemeToggle, Converter={StaticResource FilterNotConverter}}">
                                    <ListBox.Style>
                                        <Style TargetType="ListBox" BasedOn="{StaticResource ThemeOptionList}">
                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.Style>
                                    <ListBoxItem>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="40" Height="30" CornerRadius="5" Margin="0,0,10,0"
                                                    Background="#FF0D1114" BorderBrush="#FF24383A" BorderThickness="1">
                                                <Grid>
                                                    <Border Height="7" VerticalAlignment="Top" Background="#FF080B0D" BorderBrush="#FF3CCFC0" BorderThickness="0,0,0,2" CornerRadius="4,4,0,0" />
                                                    <Border Height="12" Margin="5,11,5,0" VerticalAlignment="Top" CornerRadius="3" Background="#FF131A1D" BorderBrush="#FF24383A" BorderThickness="1" />
                                                    <Border Width="13" Height="4" Margin="9,15,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="2" Background="#FF3CCFC0" />
                                                </Grid>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="卫戍协议终端" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="深灰机壳 · 青绿描边" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </ListBoxItem>
                                    <ListBoxItem>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="40" Height="30" CornerRadius="2" Margin="0,0,10,0"
                                                    Background="#FFD8CFBE" BorderBrush="#FFB5A88F" BorderThickness="1">
                                                <Grid>
                                                    <Border Height="7" VerticalAlignment="Top" Background="#FF1C1B19" BorderBrush="#FFC8372A" BorderThickness="0,0,0,2" />
                                                    <Border Height="12" Margin="5,11,5,0" VerticalAlignment="Top" CornerRadius="1" Background="#FFF2EDE3" BorderBrush="#FFB5A88F" BorderThickness="1" />
                                                    <Border Width="13" Height="4" Margin="9,15,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#FF24211D" />
                                                </Grid>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="乌萨斯齐心团" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="铁框 · 纸卡 · 海报红" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </ListBoxItem>
                                    <ListBoxItem>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="40" Height="30" CornerRadius="5" Margin="0,0,10,0"
                                                    Background="#FFF5F3FA" BorderBrush="#FFD8D1EA" BorderThickness="1">
                                                <Grid>
                                                    <Border Height="7" VerticalAlignment="Top" Background="#FF251E3E" BorderBrush="#FFE58AB8" BorderThickness="0,0,0,2" CornerRadius="4,4,0,0" />
                                                    <Border Height="12" Margin="5,11,5,0" VerticalAlignment="Top" CornerRadius="3" Background="#FFFFFFFF" BorderBrush="#FFD8D1EA" BorderThickness="1" />
                                                    <Border Width="13" Height="4" Margin="9,15,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="2" Background="#FF6A52D9" />
                                                </Grid>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="“全能的”可露希尔" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="薰衣草白 · 紫色 · 像素数字" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </ListBoxItem>
                                </ListBox>
                                <TextBlock Text="选择游戏里的主题，或开启自动识别；未识别时保留当前主题。" FontSize="11" TextWrapping="Wrap" Margin="2,0,0,6"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>

                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <DockPanel>
                                            <ListBox x:Name="DayNightSelector" DockPanel.Dock="Right" Style="{StaticResource FilterChipListBox}" VerticalAlignment="Center">
                                                <ListBoxItem Content="日间" />
                                                <ListBoxItem Content="夜间" />
                                            </ListBox>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="日间 / 夜间" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="每套主题单独记住" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Height="1" Margin="-10,10" Background="{DynamicResource LineBrush}" />
                                        <DockPanel>
                                            <CheckBox x:Name="FollowModeThemeToggle" DockPanel.Dock="Right" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"
                                                      AutomationProperties.Name="侧栏外观跟随模式主题" />
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="侧栏外观跟随模式主题" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="关闭后可单独选择侧栏外观" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <ListBox x:Name="UiThemeSelector" Style="{StaticResource FilterChipListBox}" Margin="0,8,0,0" Visibility="Collapsed">
                                            <ListBoxItem Content="终端" />
                                            <ListBoxItem Content="乌萨斯" />
                                            <ListBoxItem Content="可露希尔" />
                                        </ListBox>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="游戏连接" Style="{StaticResource SettingsCaption}" />
                                <Border Style="{StaticResource SettingsCard}">
                                    <DockPanel>
                                        <Border x:Name="GameConnectionIcon" Width="30" Height="30" CornerRadius="{DynamicResource RowCornerRadius}"
                                                Background="{DynamicResource SectionBackgroundBrush}" VerticalAlignment="Center" Margin="0,0,9,0">
                                            <TextBlock x:Name="GameConnectionGlyph" Text="PC" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                        <Button x:Name="GameConnectionButton" DockPanel.Dock="Right" Content="更改…" Click="OnGameConnection"
                                                Style="{StaticResource SmallActionButton}" VerticalAlignment="Center" />
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock x:Name="GameConnectionTitle" Text="截图来源 · PC 客户端" FontSize="12" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock x:Name="GameConnectionStatus" Text="PC 窗口截图" FontSize="11" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <TextBlock Text="追踪与侧栏" Style="{StaticResource SettingsCaption}" />
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <DockPanel>
                                            <CheckBox x:Name="MultiLineupTrackingToggle" DockPanel.Dock="Right" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"
                                                      AutomationProperties.Name="同时追踪多个队伍" />
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="同时追踪多个队伍" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="开启后追踪新阵容会追加；关闭时替换当前列表" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <!-- In-game enemy routes for this round (the switch used to draw the deployment grid). -->
                                        <Border Height="1" Margin="-10,10" Background="{DynamicResource LineBrush}" />
                                        <DockPanel>
                                            <CheckBox x:Name="BoardOverlayToggle" DockPanel.Dock="Right" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"
                                                      AutomationProperties.Name="游戏内显示敌人路线" />
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="游戏内显示敌人路线" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock x:Name="BoardStatusText" Text="休整期在棋盘上画出本回合敌人怎么走" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <!-- Opacity of the in-game board drawing (routes and placements). -->
                                        <DockPanel Margin="0,8,0,0">
                                            <TextBlock Text="不透明度" DockPanel.Dock="Left" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock x:Name="BoardOpacityText" DockPanel.Dock="Right" Width="36" TextAlignment="Right" FontSize="11"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" Text="100%" />
                                            <Slider x:Name="BoardOpacitySlider" Minimum="10" Maximum="100" SmallChange="5" LargeChange="10"
                                                    TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" Value="100"
                                                    Foreground="{DynamicResource AccentSoftBrush}" AutomationProperties.Name="游戏内显示不透明度" />
                                        </DockPanel>
                                        <Border Height="1" Margin="-10,10" Background="{DynamicResource LineBrush}" />
                                        <DockPanel>
                                            <CheckBox x:Name="FreeSidePanelMovementToggle" DockPanel.Dock="Right" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"
                                                      AutomationProperties.Name="侧栏自由移动" />
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="侧栏自由移动" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="不再跟随游戏窗口；关闭时记住当前位置并恢复跟随" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Height="1" Margin="-10,10" Background="{DynamicResource LineBrush}" />
                                        <DockPanel>
                                            <CheckBox x:Name="EdgeAutoHideToggle" DockPanel.Dock="Right" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"
                                                      AutomationProperties.Name="贴边自动隐藏" />
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="贴边自动隐藏" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="侧栏贴在屏幕边上时收成一条细边，鼠标在边上停一下就展开，移开后收回；游戏窗口模式下不收起" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Height="1" Margin="-10,10" Background="{DynamicResource LineBrush}" />
                                        <DockPanel>
                                            <Button x:Name="ResetSidePanelPositionButton" DockPanel.Dock="Right" Content="重置"
                                                    Click="OnResetSidePanelPosition" Style="{StaticResource SmallActionButton}" VerticalAlignment="Center" />
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="侧栏位置" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="清除记住的偏移，保留尺寸，恢复默认吸附" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="快捷键" Style="{StaticResource SettingsCaption}" />
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button x:Name="TogglePanelHotkeyButton" DockPanel.Dock="Right" MinWidth="96" Style="{StaticResource SmallActionButton}"
                                                    VerticalAlignment="Center" Click="OnHotkeyButtonClick" PreviewKeyDown="OnHotkeyButtonKeyDown"
                                                    LostKeyboardFocus="OnHotkeyButtonLostFocus" AutomationProperties.Name="收起 / 展开侧栏的快捷键"
                                                    ToolTip="点击后按下新的组合键；Esc 取消，Backspace 不使用" />
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="收起 / 展开侧栏" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock x:Name="TogglePanelHotkeyText" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Height="1" Margin="-10,10" Background="{DynamicResource LineBrush}" />
                                        <DockPanel>
                                            <Button x:Name="ManualScanHotkeyButton" DockPanel.Dock="Right" MinWidth="96" Style="{StaticResource SmallActionButton}"
                                                    VerticalAlignment="Center" Click="OnHotkeyButtonClick" PreviewKeyDown="OnHotkeyButtonKeyDown"
                                                    LostKeyboardFocus="OnHotkeyButtonLostFocus" AutomationProperties.Name="截屏录入的快捷键"
                                                    ToolTip="点击后按下新的组合键；Esc 取消，Backspace 不使用" />
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="截屏录入" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock x:Name="ManualScanHotkeyText" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Height="1" Margin="-10,10" Background="{DynamicResource LineBrush}" />
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="恢复默认" Click="OnResetHotkeys" Style="{StaticResource SmallActionButton}" VerticalAlignment="Center" />
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="默认快捷键" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="Ctrl + Shift + H 收起 / 展开，Ctrl + Shift + / 截屏录入" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="更新" Style="{StaticResource SettingsCaption}" />
                                <Border Style="{StaticResource SettingsCard}">
                                    <DockPanel>
                                        <Button x:Name="CheckUpdateButton" DockPanel.Dock="Right" Content="检查更新" Tag="accent"
                                                Click="OnCheckUpdate" Style="{StaticResource SmallActionButton}" VerticalAlignment="Center" />
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock x:Name="CurrentVersionText" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock x:Name="UpdateStatusText" Text="启动后自动检查，也可手动检查更新"
                                                       FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Transient toast: shown via SidePanelWindow.ShowToast(). Click-through unless visible. -->
                <Border x:Name="ToastBorder"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="0,0,0,30"
                        MaxWidth="280"
                        Background="{DynamicResource ToastBackgroundBrush}"
                        BorderBrush="{DynamicResource AccentStrongBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource RowCornerRadius}"
                        Padding="12,8"
                        Visibility="Collapsed"
                        IsHitTestVisible="False"
                        Opacity="0">
                    <TextBlock x:Name="ToastText"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="12"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </Border>

                <!-- Custom resize grip: three accent-coloured diagonal lines -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Width="20" Height="20" Cursor="SizeNWSE"
                        Background="Transparent" ToolTip="拖动调整窗口大小">
                    <Canvas Width="20" Height="20">
                        <Line X1="6"  Y1="18" X2="18" Y2="6"
                              Stroke="{DynamicResource AccentBorderBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Line X1="11" Y1="18" X2="18" Y2="11"
                              Stroke="{DynamicResource AccentStrongBorderBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Line X1="16" Y1="18" X2="18" Y2="16"
                              Stroke="{DynamicResource AccentSolidBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Canvas>
                </Border>

                <Grid x:Name="BanProcessingMask"
                      Visibility="Collapsed"
                      Background="#CC000000"
                      IsHitTestVisible="True">
                    <Border HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{DynamicResource MaskCardBackgroundBrush}"
                            BorderBrush="{DynamicResource AccentBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RowCornerRadius}"
                            Padding="16,12">
                        <TextBlock x:Name="BanProcessingMaskText"
                                   Text="ban位识别中，请勿操作鼠标"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </Border>
                </Grid>
            </Grid>
            </DockPanel>
        </DockPanel>
    </Border>
</Window>
