<!-- Modified for ASP Assistant Regulation on 2026-11-09; see NOTICE. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:ASPAssistant.App.Converters">

    <!-- Clickable-control baseline: only interactive controls get hand cursor -->
    <Style x:Key="ClickableButtonBase" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="ClickableToggleButtonBase" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="ClickableListBoxItemBase" TargetType="ListBoxItem">
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- Card -->
    <Style x:Key="ItemCardBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- Trait tag chip -->
    <Style x:Key="TraitTagBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="5,1" />
        <Setter Property="Margin" Value="0,0,4,2" />
    </Style>

    <!-- Variant toggle: individual segment button -->
    <Style x:Key="VariantToggleButton" TargetType="ToggleButton" BasedOn="{StaticResource ClickableToggleButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bg" Background="{TemplateBinding Background}"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource AccentBrush}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ban toggle button (red when banned, neutral when not) -->
    <Style x:Key="BanToggleButton" TargetType="Button" BasedOn="{StaticResource ClickableButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="banned">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource DangerTintBrush}" />
                            <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                            <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Tag" Value="banned" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource DangerBorderBrush}" />
                            <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tracking button -->
    <Style x:Key="TrackingButton" TargetType="Button" BasedOn="{StaticResource ClickableButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="tracked">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource AccentTintBrush}" />
                            <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                            <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Tag" Value="tracked" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                            <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Filter chip (ListBoxItem) -->
    <Style x:Key="FilterChipItem" TargetType="ListBoxItem" BasedOn="{StaticResource ClickableListBoxItemBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SoftBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bg" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="available">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource AvailableTintBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AvailableBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <!-- Selected: tinted fill + coloured text/border (light theme uses orange) -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource FilterSelectedTintBrush}" />
                            <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource FilterSelectedBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource FilterSelectedBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource NeutralTintBrush}" />
                            <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource NeutralStrongBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource FilterSelectedSoftBrush}" />
                            <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource FilterSelectedBrush}" />
                        </MultiTrigger>
                        <Trigger Property="Tag" Value="available">
                            <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource AvailableBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Filter group header: 11px semibold label with a hairline running to the right -->
    <Style x:Key="FilterGroupHeader" TargetType="ContentControl">
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <DockPanel LastChildFill="True">
                        <ContentPresenter DockPanel.Dock="Left" VerticalAlignment="Center"
                                          TextElement.FontSize="11"
                                          TextElement.FontWeight="SemiBold"
                                          TextElement.Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Border Height="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                Background="{DynamicResource SoftBorderBrush}" />
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Filter toggle: pill button with an arrow and an active-filter count badge -->
    <Style x:Key="FilterTogglePill" TargetType="ToggleButton" BasedOn="{StaticResource ClickableToggleButtonBase}">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="pill" CornerRadius="12" Padding="10,4"
                            Background="{DynamicResource NeutralTintBrush}"
                            BorderBrush="{DynamicResource SoftBorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="arrow" Text="▸" FontSize="10" Margin="0,0,6,0"
                                       VerticalAlignment="Center" />
                            <ContentPresenter VerticalAlignment="Center" />
                            <Border x:Name="countBadge" Margin="6,0,0,0" CornerRadius="8" Padding="5,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource FilterSelectedTintBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveFilterCount}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding ActiveFilterCount}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource FilterSelectedBrush}" />
                            </Border>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="arrow" Property="Text" Value="▾" />
                            <Setter TargetName="pill" Property="Background" Value="{DynamicResource FilterSelectedTintBrush}" />
                            <Setter TargetName="pill" Property="BorderBrush" Value="{DynamicResource FilterSelectedBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource FilterSelectedBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="pill" Property="BorderBrush" Value="{DynamicResource NeutralStrongBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Filter ListBox (chip container) -->
    <Style x:Key="FilterChipListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource FilterChipItem}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Scrollbar: slim, no arrows, rounded thumb -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="6" />
        <Setter Property="MinWidth" Value="6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid>
                        <Border Background="{DynamicResource ScrollTrackBrush}" CornerRadius="3" />
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{DynamicResource ScrollThumbBrush}" CornerRadius="3"
                                                    Margin="1,0" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tab Control: dark flat -->
    <Style x:Key="DarkTabControl" TargetType="TabControl">
        <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <!-- Tab strip fills full width -->
                        <Border DockPanel.Dock="Top" Background="{DynamicResource TitleBackgroundBrush}" BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource BorderBrush}">
                            <UniformGrid x:Name="HeaderPanel" IsItemsHost="True"
                                         Rows="1" />
                        </Border>
                        <Border x:Name="ContentPanel" Background="{DynamicResource PanelBackgroundBrush}">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent" />
                        </Border>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tab Item: flat, equal width, accent underline when active -->
    <Style TargetType="TabItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid>
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="headerContent"
                                              ContentSource="Header"
                                              Cursor="Hand"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <!-- Bottom accent line -->
                        <Border x:Name="accentLine" Height="2" VerticalAlignment="Bottom"
                                Background="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="accentLine" Property="Visibility" Value="Visible" />
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource AccentFaintBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Title bar button (minimize / close) -->
    <Style x:Key="TitleBarButton" TargetType="Button" BasedOn="{StaticResource ClickableButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource NeutralHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Small outlined pill used for secondary actions (重置 / 清除 / 截屏录入 …). Tag="danger" or "accent" tints it. -->
    <Style x:Key="SmallActionButton" TargetType="Button" BasedOn="{StaticResource ClickableButtonBase}">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="accent">
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="danger">
                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="available">
                            <Setter Property="Foreground" Value="{DynamicResource AvailableBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource NeutralHoverBrush}" />
                            <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Tag" Value="danger" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                            <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bg" Property="Opacity" Value="0.75" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bg" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small section label: bold title, muted count to its right, hairline filling the rest -->
    <Style x:Key="SectionLabelText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ── Operator hover details (普通 / 精锐), shared by the operator rows and the planner ──
         Use inside a ToolTip whose DataContext is the Operator:
         <ContentControl Content="{Binding}" ContentTemplate="{StaticResource OperatorDetailsTemplate}" /> -->
    <converters:TierToRomanConverter x:Key="DetailsTierToRoman" />
    <converters:LocalPathToImageConverter x:Key="DetailsLocalImage" />
    <DataTemplate x:Key="OperatorDetailsCovenantChip">
        <Border Background="{DynamicResource AccentTintBrush}" CornerRadius="4" Padding="5,2" Margin="0,0,4,4">
            <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
        </Border>
    </DataTemplate>
    <DataTemplate x:Key="OperatorVariantDetails">
        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8"
                BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                BorderThickness="1" Padding="12" Width="228" VerticalAlignment="Top">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <Border DockPanel.Dock="Left" Width="56" Height="56" Margin="0,0,10,0"
                            Background="{DynamicResource NeutralHoverBrush}" CornerRadius="4" ClipToBounds="True">
                        <Image Stretch="UniformToFill"
                               Source="{Binding DataContext.IconPath, RelativeSource={RelativeSource AncestorType=ToolTip}, Converter={StaticResource DetailsLocalImage}}" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="{Binding DataContext.Name, RelativeSource={RelativeSource AncestorType=ToolTip}}"
                                   Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15"
                                   FontWeight="SemiBold" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding DataContext.Tier, RelativeSource={RelativeSource AncestorType=ToolTip}, Converter={StaticResource DetailsTierToRoman}}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                       FontSize="12" FontWeight="Bold" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
                <WrapPanel Margin="0,0,0,6">
                    <ItemsControl ItemsSource="{Binding DataContext.CoreCovenants, RelativeSource={RelativeSource AncestorType=ToolTip}}"
                                  ItemTemplate="{StaticResource OperatorDetailsCovenantChip}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding DataContext.AdditionalCovenants, RelativeSource={RelativeSource AncestorType=ToolTip}}"
                                  ItemTemplate="{StaticResource OperatorDetailsCovenantChip}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </WrapPanel>
                <ItemsControl ItemsSource="{Binding Traits}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Text="{Binding TraitType}" FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding TraitDescription}" FontSize="12" LineHeight="19"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </DataTemplate>
    <DataTemplate x:Key="OperatorDetailsTemplate">
        <StackPanel Orientation="Horizontal">
            <ContentControl Content="{Binding Normal}" Tag="普通" Foreground="{DynamicResource AccentBrush}"
                            ContentTemplate="{StaticResource OperatorVariantDetails}" VerticalAlignment="Top" />
            <ContentControl Content="{Binding Elite}" Tag="精锐" Margin="8,0,0,0" Foreground="{DynamicResource EliteBrush}"
                            ContentTemplate="{StaticResource OperatorVariantDetails}" VerticalAlignment="Top" />
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
