<!-- Modified for ASP Assistant Regulation on 2026-11-09; see NOTICE. -->
<UserControl x:Class="ASPAssistant.App.Views.OperatorBrowseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ASPAssistant.App.Controls"
             xmlns:converters="clr-namespace:ASPAssistant.App.Converters"
             xmlns:componentModel="clr-namespace:System.ComponentModel;assembly=WindowsBase"
             Background="{DynamicResource PanelBackgroundBrush}">
    <UserControl.Resources>
        <converters:NullToStringConverter x:Key="NullToAll" />
        <converters:TierToRomanConverter x:Key="TierToRoman" />
        <converters:CovenantHighlightConverter x:Key="CovenantHighlight" />
        <Style x:Key="CovenantFilterItem" TargetType="ListBoxItem" BasedOn="{StaticResource FilterChipItem}">
            <Setter Property="Tag">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource CovenantHighlight}" Mode="OneWay">
                        <Binding />
                        <Binding Path="DataContext.HighlightedCovenants"
                                 RelativeSource="{RelativeSource AncestorType=UserControl}" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>
        </Style>
        <CollectionViewSource x:Key="OperatorsByTier" Source="{Binding FilteredOperators}">
            <CollectionViewSource.SortDescriptions>
                <componentModel:SortDescription PropertyName="Tier" Direction="Ascending" />
            </CollectionViewSource.SortDescriptions>
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Tier" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>
    <DockPanel>
        <!-- Search row: search box + 截屏录入 -->
        <StackPanel DockPanel.Dock="Top" Margin="8,8,8,6">
            <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="ManualScanButton" Content="截屏录入" Tag="accent" Height="30"
                        Margin="6,0,0,0" Padding="11,0" Style="{StaticResource SmallActionButton}"
                        ToolTip="打开游戏内的本局信息页后点击，录入 Ban 位、盟约和敌人"
                        Click="OnManualScanClicked" />
                <Border Height="30" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="15" Padding="10,0">
                    <DockPanel>
                        <Path DockPanel.Dock="Left" Width="12" Height="12" Margin="0,0,7,0" Stretch="Uniform" VerticalAlignment="Center"
                              Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.6"
                              Data="M7,1 A6,6 0 1 1 6.99,1 Z M11.5,11.5 L16,16" />
                        <Grid>
                            <TextBlock Text="搜索干员名称" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Foreground="{DynamicResource TextSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderThickness="0" Padding="0" FontSize="12" VerticalContentAlignment="Center"
                                     CaretBrush="{DynamicResource AccentBrush}" />
                        </Grid>
                    </DockPanel>
                </Border>
            </DockPanel>
            <TextBlock x:Name="ManualScanStatusText" FontSize="11" Margin="4,4,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed" />
        </StackPanel>

        <!-- Filter panel: two-row Grid — header row (toggle + tags) above content row (lists).
             No overlay: tags fill the DockPanel remainder, toggle is always protected on the left. -->
        <Grid DockPanel.Dock="Top" Margin="8,0,8,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="FilterContentRow" Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: "筛选" toggle (left) + active filter tag chips (fills right) -->
            <DockPanel Grid.Row="0" LastChildFill="True">
                <ToggleButton x:Name="FilterToggle" DockPanel.Dock="Left"
                              Style="{StaticResource FilterTogglePill}"
                              Content="筛选" />

                <ItemsControl x:Name="FilterTagsControl"
                              ItemsSource="{Binding ActiveFilterTags}"
                              HorizontalAlignment="Right">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Right" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Border Padding="7,2" Margin="0,0,3,2"
                                        Background="{DynamicResource AccentTintBrush}"
                                        BorderBrush="{DynamicResource AccentBrush}"
                                        BorderThickness="1" CornerRadius="10">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="|">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding}" FontSize="11"
                                               Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                                <TextBlock Text="|" FontSize="11" Margin="1,0,3,2"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="|">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>

            <!-- Row 1: Filter lists — shown only when FilterToggle is checked -->
            <StackPanel x:Name="FilterContentPanel" Grid.Row="1"
                        ClipToBounds="True" Margin="0,6,0,2">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=FilterToggle}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <!-- Availability filter (ban status) + run actions -->
                <DockPanel Margin="0,0,0,6">
                    <WrapPanel DockPanel.Dock="Right" Margin="6,0,0,0">
                        <Button x:Name="ResetFiltersButton" Content="重置筛选" Style="{StaticResource SmallActionButton}"
                                Margin="4,0,0,0" ToolTip="把所有筛选恢复为默认状态" Click="OnResetFiltersClicked" />
                        <Button x:Name="ClearHighlightsButton" Content="清除高亮" Tag="available" Style="{StaticResource SmallActionButton}"
                                Margin="4,0,0,0" ToolTip="清除本局可用盟约的高亮" Click="OnClearHighlightsClicked" />
                        <Button x:Name="ClearBansButton" Content="清除 Ban 位" Tag="danger" Style="{StaticResource SmallActionButton}"
                                Margin="4,0,0,0" ToolTip="清除本局录入的禁用干员" Click="OnClearBansClicked" />
                    </WrapPanel>
                    <ContentControl Style="{StaticResource FilterGroupHeader}" Margin="0" Content="本局状态" VerticalAlignment="Center" />
                </DockPanel>
                <ListBox x:Name="AvailabilityFilterList"
                         Style="{StaticResource FilterChipListBox}"
                         Margin="0,0,0,6"
                         SelectionChanged="OnAvailabilityFilterChanged">
                    <ListBoxItem Content="全部" />
                    <ListBoxItem Content="本局可用" />
                    <ListBoxItem Content="本局不可用" />
                </ListBox>

                <ContentControl Style="{StaticResource FilterGroupHeader}" Margin="0,0,0,6" Content="等阶" />
                <ListBox x:Name="TierFilterList"
                         SelectionMode="Multiple"
                         Style="{StaticResource FilterChipListBox}"
                         ItemsSource="{Binding AvailableTiers}"
                         PreviewMouseLeftButtonDown="OnTierFilterPreviewMouseDown"
                         SelectionChanged="OnTierFilterChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource TierToRoman}, ConverterParameter=全部}"
                                       FontSize="11" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <DockPanel Margin="0,10,0,6">
                    <CheckBox x:Name="CoreCovenantMatchAllToggle" DockPanel.Dock="Right" Content="同时选中"
                              FontSize="11" Margin="8,0,0,0"
                              VerticalAlignment="Center"
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              ToolTip="勾选后，选中的核心盟约必须同时具备"
                              IsChecked="{Binding CoreCovenantMatchAll, Mode=TwoWay}" />
                    <ContentControl Style="{StaticResource FilterGroupHeader}" Margin="0" Content="核心盟约" />
                </DockPanel>
                <ListBox x:Name="CoreCovenantFilterList"
                         SelectionMode="Multiple"
                         Style="{StaticResource FilterChipListBox}"
                         ItemContainerStyle="{StaticResource CovenantFilterItem}"
                         ItemsSource="{Binding AvailableCoreCovenants}"
                         PreviewMouseLeftButtonDown="OnCoreCovenantPreviewMouseDown"
                         SelectionChanged="OnCovenantFilterChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource NullToAll}, ConverterParameter=全部}"
                                       FontSize="11" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <DockPanel Margin="0,10,0,6">
                    <CheckBox x:Name="OtherCovenantMatchAllToggle" DockPanel.Dock="Right" Content="同时选中"
                              FontSize="11" Margin="8,0,0,0"
                              VerticalAlignment="Center"
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              ToolTip="勾选后，选中的附加盟约必须同时具备"
                              IsChecked="{Binding OtherCovenantMatchAll, Mode=TwoWay}" />
                    <ContentControl Style="{StaticResource FilterGroupHeader}" Margin="0" Content="其他盟约" />
                </DockPanel>
                <ListBox x:Name="OtherCovenantFilterList"
                         SelectionMode="Multiple"
                         Style="{StaticResource FilterChipListBox}"
                         ItemContainerStyle="{StaticResource CovenantFilterItem}"
                         ItemsSource="{Binding AvailableOtherCovenants}"
                         PreviewMouseLeftButtonDown="OnOtherCovenantPreviewMouseDown"
                         SelectionChanged="OnCovenantFilterChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource NullToAll}, ConverterParameter=全部}"
                                       FontSize="11" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ContentControl Style="{StaticResource FilterGroupHeader}" Margin="0,10,0,6" Content="词条" />
                <ListBox x:Name="TraitFilterList"
                         Style="{StaticResource FilterChipListBox}"
                         ItemsSource="{Binding AvailableTraitTypes}"
                         PreviewMouseLeftButtonDown="OnFilterListPreviewMouseDown"
                         SelectionChanged="OnTraitFilterChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource NullToAll}, ConverterParameter=全部}"
                                       FontSize="11" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ContentControl Style="{StaticResource FilterGroupHeader}" Margin="0,10,0,6" Content="触发时机" />
                <ListBox x:Name="TriggerTimingFilterList"
                         Style="{StaticResource FilterChipListBox}"
                         ItemsSource="{Binding AvailableTriggerTimings}"
                         PreviewMouseLeftButtonDown="OnFilterListPreviewMouseDown"
                         SelectionChanged="OnTriggerTimingFilterChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource NullToAll}, ConverterParameter=全部}"
                                       FontSize="11" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Grid>

        <!-- Operator list (virtualized: ScrollViewer lives inside the template so WPF can recycle cards) -->
        <Grid>
            <ItemsControl x:Name="OperatorListControl" ItemsSource="{Binding Source={StaticResource OperatorsByTier}}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      CanContentScroll="True"
                                      Focusable="False">
                            <ItemsPresenter Margin="8,0,8,8" />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <DockPanel Margin="2,10,2,6">
                                    <Border DockPanel.Dock="Left" CornerRadius="4" Padding="7,1" Margin="0,0,6,0"
                                            Background="{DynamicResource SectionBackgroundBrush}">
                                        <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold">
                                            <Run Text="{Binding Name, Mode=OneWay, Converter={StaticResource TierToRoman}}" /><Run Text=" 阶" />
                                        </TextBlock>
                                    </Border>
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding ItemCount}" FontSize="11" Margin="0,0,8,0"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Rectangle Height="1" VerticalAlignment="Center" Fill="{DynamicResource BorderBrush}" />
                                </DockPanel>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                        <GroupStyle.Panel>
                            <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                        </GroupStyle.Panel>
                    </GroupStyle>
                </ItemsControl.GroupStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:OperatorCard TrackingToggled="OnOperatorTrackingToggled"
                                              controls:OperatorCard.BanToggled="OnOperatorBanToggled" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="EmptyFilterText"
                       Text="{Binding EmptyListMessage}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="24,0"
                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FilteredOperators.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </DockPanel>
</UserControl>
