<UserControl x:Class="ASPAssistant.App.Views.EquipmentBrowseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ASPAssistant.App.Controls"
             xmlns:converters="clr-namespace:ASPAssistant.App.Converters"
             Background="{DynamicResource PanelBackgroundBrush}"
             DataContextChanged="OnViewDataContextChanged">
    <UserControl.Resources>
        <converters:NullToStringConverter x:Key="NullToAll" />
    </UserControl.Resources>
    <DockPanel>
        <TextBox DockPanel.Dock="Top" Margin="8"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                 BorderBrush="{DynamicResource BorderBrush}" Padding="6,4" />
        <StackPanel DockPanel.Dock="Top" Margin="8,0,8,4">
            <ToggleButton x:Name="FilterToggle"
                          HorizontalAlignment="Left"
                          Style="{StaticResource FilterTogglePill}"
                          Content="筛选" />

            <StackPanel Margin="0,6,0,2">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=FilterToggle}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <ContentControl Style="{StaticResource FilterGroupHeader}" Margin="0,0,0,6" Content="等阶" />
                <ListBox x:Name="TierFilterList"
                         SelectionMode="Multiple"
                         Style="{StaticResource FilterChipListBox}"
                         ItemsSource="{Binding AvailableTiers}"
                         PreviewMouseLeftButtonDown="OnTierFilterPreviewMouseDown"
                         SelectionChanged="OnTierFilterChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource NullToAll}, ConverterParameter=全部}"
                                       FontSize="11" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <DockPanel Margin="0,10,0,6">
                    <CheckBox x:Name="CategoryMatchAllToggle" DockPanel.Dock="Right" Content="同时选中"
                              FontSize="11" Margin="8,0,0,0"
                              VerticalAlignment="Center"
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              ToolTip="勾选后，装备必须同时属于所有选中类型"
                              IsChecked="{Binding CategoryMatchAll, Mode=TwoWay}" />
                    <ContentControl Style="{StaticResource FilterGroupHeader}" Margin="0" Content="类型" />
                </DockPanel>
                <ListBox x:Name="CategoryFilterList"
                         SelectionMode="Multiple"
                         Style="{StaticResource FilterChipListBox}"
                         ItemsSource="{Binding AvailableCategories}"
                         PreviewMouseLeftButtonDown="OnCategoryFilterPreviewMouseDown"
                         SelectionChanged="OnCategoryFilterChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource NullToAll}, ConverterParameter=全部}"
                                       FontSize="11" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ContentControl Style="{StaticResource FilterGroupHeader}" Margin="0,10,0,6" Content="装备类别" />
                <ListBox x:Name="TypeFilterList"
                         Style="{StaticResource FilterChipListBox}"
                         ItemsSource="{Binding AvailableTypes}"
                         SelectionChanged="OnTypeFilterChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource NullToAll}, ConverterParameter=全部}"
                                       FontSize="11" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </StackPanel>
        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="EquipmentListControl" ItemsSource="{Binding FilteredEquipment}" Margin="8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:EquipmentCard TrackingToggled="OnEquipmentTrackingToggled" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="EmptyFilterText"
                       Text="{Binding EmptyListMessage}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="24,0"
                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FilteredEquipment.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </DockPanel>
</UserControl>
