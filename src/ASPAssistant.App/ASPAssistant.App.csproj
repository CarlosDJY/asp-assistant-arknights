<!-- Modified for ASP Assistant Regulation on 2026-11-09; see NOTICE. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Version is overridden by CI via -p:Version=x.y.z during release builds -->
    <Version>1.7.1</Version>
    <AssemblyTitle>Hongxue Stronghold Companion</AssemblyTitle>
    <Product>Hongxue Stronghold Companion</Product>
    <!-- Custom entry point with OS version guard (Program.cs); overrides WPF auto-generated Main -->
    <StartupObject>ASPAssistant.App.Program</StartupObject>
    <ApplicationIcon>..\..\data\icons\aspa_logo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Keep only Simplified Chinese satellite assemblies; removes cs/de/es/fr/… folders from output -->
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ASPAssistant.Core\ASPAssistant.Core.csproj" />
    <InternalsVisibleTo Include="ASPAssistant.Tests" />
    <Resource Include="..\..\data\icons\aspa_logo.png" Link="Resources\aspa_logo.png" />
    <!-- Number fonts of the redesign themes (SIL Open Font License, see Resources/Fonts/OFL-*.txt) -->
    <Resource Include="Resources\Fonts\*.ttf" />
    <!-- Map thumbnails for the placement page's map picker (cropped in-game screenshots) -->
    <Resource Include="Resources\MapThumbs\*.jpg" />
    <Content Include="Resources\Fonts\OFL-*.txt" Link="licenses\fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\LICENSE;..\..\LICENSE.upstream;..\..\NOTICE"
             Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\data\**\*.json" Link="data\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\data\icons\**\*.png" Link="data\icons\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Enemy-type icons downloaded by fetch_spdatabase.py (7 type badges) -->
    <Content Include="..\..\data\icons\enemy_types\*.png"
             Link="data\icons\enemy_types\%(Filename)%(Extension)"
             Condition="Exists('..\..\data\icons\enemy_types')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Special-enemy (小怪) portraits downloaded by fetch_spdatabase.py -->
    <Content Include="..\..\data\icons\enemies\*.png"
             Link="data\icons\enemies\%(Filename)%(Extension)"
             Condition="Exists('..\..\data\icons\enemies')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Boss avatar portraits downloaded by fetch_spdatabase.py -->
    <Content Include="..\..\data\icons\bosses\*.png"
             Link="data\icons\bosses\%(Filename)%(Extension)"
             Condition="Exists('..\..\data\icons\bosses')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Card template images (op_card.png, etc.) copied to data/template/ for reference. -->
    <Content Include="..\..\data\template\*.png" Link="data\template\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- MaaFramework TemplateMatch bundle: op_card.png is looked up at
         [bundle]/image/op_card.png when MaaCardDetector calls TemplateMatch. -->
    <Content Include="..\..\data\template\op_card.png" Link="data\maa_resource\image\op_card.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Ban-indicator badge template for BanIndicatorDetector (FeatureMatch).
         Placed in data/template/ban_indicator.png; copied to maa_resource/image/ so
         MaaFramework's resource bundle can index it. Only included when the file exists. -->
    <Content Include="..\..\data\template\ban_indicator.png"
             Link="data\maa_resource\image\ban_indicator.png"
             Condition="Exists('..\..\data\template\ban_indicator.png')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- PRTS operator portrait icons (kept as reference; used until ban_screen set is complete).
         MaaBanIconMatcher previously looked them up at [bundle]/image/operators/{name}.png. -->
    <Content Include="..\..\data\icons\operators\*.png" Link="data\maa_resource\image\operators\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Skin avatar portraits from PRTS skin_table; used as ban-matching templates.
         MaaBanIconMatcher looks them up at [bundle]/image/skin_avatars/{avatarId}.png. -->
    <Content Include="..\..\data\icons\skin_avatars\*.png" Link="data\maa_resource\image\skin_avatars\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- MaaFramework requires at least one valid JSON file inside pipeline/. -->
    <Content Include="..\..\data\maa_resource\pipeline\empty.json" Link="data\maa_resource\pipeline\empty.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\data\model\**\*" Link="data\model\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
